#!/usr/bin/env bash
# -----------------------------------------------------------------------------
# Pre-commit guard: blocks a commit that contains GISAID data, unpublished JHH
# data, anything from source/, databases/archives, top-level data files,
# new Jupyter notebooks or files over 10 MB. All checks live in
# scripts/data_guard.sh (run it by hand with --help for details).
#
# Enabled per clone by `bash scripts/build_env.sh`, or by hand with:
#     git config core.hooksPath .githooks
# Never bypass it with `git commit --no-verify`.
# -----------------------------------------------------------------------------
root=$(git rev-parse --show-toplevel) || exit 1
guard="$root/scripts/data_guard.sh"
if [ ! -f "$guard" ]; then
    echo "pre-commit: $guard is missing; refusing to commit without the data check." >&2
    exit 1
fi
exec bash "$guard" --staged
